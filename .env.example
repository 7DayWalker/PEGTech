# ============================================================================
# Lead Gen SaaS — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# App
SECRET_KEY=change-me-to-a-random-secret-key
ENVIRONMENT=development
DEBUG=true

# Server
PORT=8000

# Database (Railway PostgreSQL — add the PostgreSQL plugin on Railway)
# Example: postgres://user:password@host:port/database
DATABASE_URL=sqlite:///./leadgen.db

# Email (SMTP — Gmail, SendGrid, Mailgun, etc.)
SENDER_EMAIL=you@yourdomain.com
SENDER_NAME=Your Company
SENDER_PHONE=+1234567890
POSTAL_ADDRESS=123 Business St, City, State, ZIP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Compliance / outreach URLs (your Railway domain)
UNSUBSCRIBE_BASE_URL=https://your-app.railway.app
PREVIEW_BASE_URL=https://your-app.railway.app

# WhatsApp Business (Meta Graph API)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=leadgen_verify_token

# Google Drive (optional asset backup)
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# CORS
CORS_ORIGINS=*